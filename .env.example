# Copy to .env.local and fill in. Never commit real values.

# Local development only: set to "claude-local" to run the guide on your own
# Claude Code login instead of an API key. Prefer `npm run dev:local`, which sets
# this and binds the dev server to 127.0.0.1. Ignored outside `next dev`.
MODEL_PROVIDER=

# Neon (set by the Vercel Neon integration; `vercel env pull .env.local`).
NEON_AUTH_BASE_URL=
NEON_DATABASE_URL=
# 32+ random characters (openssl rand -base64 32). Not set by Neon.
NEON_AUTH_COOKIE_SECRET=
